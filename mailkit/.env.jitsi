# This is an example environment file for Jitsi Meet.
# Copy this file to .env.jitsi and fill in the values.

# FQDN for the Jitsi Meet instance
PUBLIC_URL=https://meet.tudominio.com

# Docker host address
DOCKER_HOST_ADDRESS=127.0.0.1

# Jitsi Videobridge port
JVB_PORT=10000

# Jitsi TCP port
JVB_TCP_PORT=4443

# XMPP domain
XMPP_DOMAIN=meet.tudominio.com
XMPP_AUTH_DOMAIN=meet.tudominio.com
XMPP_BOSH_ROOT=http://prosody:5280
XMPP_MUC_DOMAIN=muc.meet.tudominio.com
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.tudominio.com

# Jicofo authentication
JICOFO_COMPONENT_SECRET=changeme
JICOFO_AUTH_USER=focus
JICOFO_AUTH_PASSWORD=changeme

# JVB authentication
JVB_AUTH_USER=jvb
JVB_AUTH_PASSWORD=changeme

# Jibri authentication (for recording)
JIBRI_BREWERY_MUC=jibribrewery
JIBRI_PENDING_TIMEOUT=90
JIBRI_STRIP_FROM_NODE_ID=true
JIBRI_XMPP_USER=jibri
JIBRI_XMPP_PASSWORD=changeme
JIBRI_RECORDER_USER=recorder
JIBRI_RECORDER_PASSWORD=changeme

# Timezone
TZ=UTC
