{
    # Para un despliegue en producción, Caddy usará automáticamente el emisor de producción de Let's Encrypt.
    # Asegúrate de que tu DNS esté apuntando correctamente al servidor.
    # Para pruebas locales con localhost, Caddy generará certificados autofirmados.
    email youremail@example.com
}

