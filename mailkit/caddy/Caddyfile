{
    # Esta opción global permite a Caddy manejar automáticamente los certificados.
    # Para dominios públicos, usará Let's Encrypt.
    # Para localhost o IPs, generará un certificado autofirmado (confía en él en tu navegador).
    acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
    email youremail@example.com
}

mail.{$DOMAIN} {
    reverse_proxy stalwart:8080
}

webmail.{$DOMAIN} {
    reverse_proxy webmail:3000
}

admin.{$DOMAIN} {
    reverse_proxy admin-panel:3000
}

it.{$DOMAIN} {
    reverse_proxy it-panel:3000
}

router.{$DOMAIN} {
    reverse_proxy send-router:3000
}

sso.{$DOMAIN} {
    reverse_proxy keycloak:8080
}

chat.{$DOMAIN} {
    reverse_proxy synapse:8008
}

element.{$DOMAIN} {
    reverse_proxy element:80
}

meet.{$DOMAIN} {
    reverse_proxy jitsi:80
}

cloud.{$DOMAIN} {
    reverse_proxy nextcloud:80
}
