# This is an example environment file.
# Copy this file to .env and fill in the values.

# Database settings for Nextcloud
MYSQL_ROOT_PASSWORD=changeme
MYSQL_PASSWORD=changeme

# Backup settings
RESTIC_PASSWORD=changeme

# JMAP credentials for webmail (for development only)
# In a real application, you would use a proper authentication flow.
NEXT_PUBLIC_JMAP_USERNAME=user@tudominio.com
NEXT_PUBLIC_JMAP_PASSWORD=changeme
