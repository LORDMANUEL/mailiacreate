# This is an example environment file.
# Copy this file to .env and fill in the values.

# -- General Settings --
# The main domain for your mail server.
# For local testing, you can use "localhost" or a local network IP like "192.168.1.100".
DOMAIN=localhost

# Database settings for Nextcloud
MYSQL_ROOT_PASSWORD=changeme
MYSQL_PASSWORD=changeme

# Backup settings
RESTIC_PASSWORD=changeme

# Keycloak settings
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=changeme
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=changeme

# Stalwart OIDC Client Secret
# Get this from the 'stalwart' client credentials tab in the Keycloak admin console.
STALWART_CLIENT_SECRET=changeme

# Keycloak Admin API Client
# Credentials for a dedicated client with permissions to manage users.
# See README for instructions on creating this client.
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli-service
KEYCLOAK_ADMIN_CLIENT_SECRET=changeme

# Send-Router SMTP Settings
# Credentials for the Send-Router to authenticate with the Stalwart SMTP server.
# This should be a dedicated user created in Keycloak.
SMTP_USER=router@${DOMAIN}
SMTP_PASSWORD=changeme

# Matrix Send-Router Settings
# The homeserver URL for the Matrix server.
MATRIX_HOMESERVER_URL=https://chat.${DOMAIN}
# An access token for a bot user on the Matrix server.
MATRIX_ACCESS_TOKEN=changeme
